<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>lab.jvm</groupId>
  <artifactId>serialization-bench</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <!-- 编译目标：JDK 25（与 Kona JDK 25 的字节码版本一致） -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- 源码用 UTF-8，保证中文注释不乱码 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JMH 版本：核心库与注解处理器必须同版本 -->
    <jmh.version>1.37</jmh.version>
  </properties>

  <dependencies>
    <!-- JMH 核心库：基准运行时的引擎（负责预热/计分/输出报告） -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
    <!-- JMH 注解处理器：编译期扫描 @Benchmark 方法，生成对应的运行时代码 -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <!-- provided：只在编译期需要，不打包进最终 jar -->
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!--
            JDK 23+ 默认不再自动从 classpath 发现注解处理器，
            必须在这里显式声明 JMH 的注解处理器，否则 jar 里没有
            META-INF/BenchmarkList，运行时会报 "Unable to find BenchmarkList"。
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- 打成 fat jar：把 JMH 引擎一起打进去，入口指向 JMH Main -->
              <finalName>serialization-bench</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
